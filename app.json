{
  "expo": {
    "name": "Thirupugazh(திருப்புகழ் ̇)",
    "slug": "Thirupugazh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "thirupugazh",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.murugarthunai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D4520A"
      },
      "package": "com.murugarthunai.app"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#D4520A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
